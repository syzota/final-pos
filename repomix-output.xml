  height: 38px;
  border-radius: 50%;
  background: #e7eeff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  transition: .25s;
}

.social-icon-btn:hover {
  background: var(--color-primary);
  color: #fff;
}

/* =====================================
   TABLET
===================================== */

@media (max-width:1024px){

.footer-top{
    flex-direction:column;
}

.footer-links-group{
    width:100%;
    justify-content:space-between;
}

}

/* =====================================
   MOBILE
===================================== */

@media (max-width:640px){

.footer-wrapper{
    display:block;
    margin-top:28px;
}

.footer-content{
    padding:24px 18px;
    gap:28px;
}

.footer-top{
    flex-direction:column;
    gap:28px;
}

.footer-brand{
    max-width:100%;
}

.footer-brand-title{
    font-size:17px;
}

.footer-desc{
    font-size:13px;
}

.footer-links-group{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.footer-col:last-child{
    grid-column:1/-1;
}

.footer-bottom{
