                <div>
                  <div className="r-num">{getJaninResult().ukuran}</div>
                  <div className="r-label">{getJaninResult().desc}</div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* 3. Kenaikan BB Hamil */}
        {currentTool === 'bb_hamil' && (
          <div className="grid grid-2">
            <div className="card">
