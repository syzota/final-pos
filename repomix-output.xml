  .related-articles-card {
    padding: 18px 14px;
  }

  .progress-cta-card {
    padding: 20px 16px;
  }
}

@media (max-width: 480px) {
  .detail-artikel-title {
    font-size: 19px;
  }

  .meta-author-avatar {
    width: 34px;
    height: 34px;
