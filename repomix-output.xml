  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.medical-hero__badge i {
  color: #b9dcff;
  font-size: 14px;
}

.medical-hero__title {
  margin: 0;
  color: #ffffff;
  font-size: clamp(2.35rem, 4.4vw, 4.35rem);
  line-height: 1.03;
  letter-spacing: -0.045em;
  font-weight: 800;
  text-shadow: 0 5px 30px rgba(15, 39, 64, 0.24);
}

.medical-hero__title span {
  color: #c7e4ff;
}

.medical-hero__description {
