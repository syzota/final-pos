  border-radius: 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.jadwal-card-header {
  display: flex;
  align-items: center;
  gap: 14px;
}

.jadwal-icon-box {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background-color: #99c2f1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.jadwal-card-heading {
