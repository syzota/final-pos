}

.grid {
  display: grid;
  gap: 24px;
}

.grid-2,
.kalkulator-calc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.food-log-input-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.food-select {
