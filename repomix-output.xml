  box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.08);
}

.feature-icon-bg {
  width: 48px;
  height: 48px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--color-dark);
  padding-top: 8px;
}

.feature-desc {
  font-size: 12px;
  color: var(--color-text-subtle);
  line-height: 1.6;
}

/* Indicators Row (legacy, unused) */
.indicators-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.indicator-card {
  background-color: var(--color-card-bg);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 24px;
  border-top: 4px solid transparent;
}

.indicator-card.blue-top {
  border-top-color: var(--color-primary);
}

.indicator-card.pink-top {
  border-top-color: var(--color-pink-accent);
}

.indicator-card.dark-theme {
  background-color: var(--color-card-dark);
  color: #ffffff;
}

.indicator-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.indicator-icon-bg {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.indicator-icon-bg.blue-bg {
  background-color: rgba(153, 194, 241, 0.3);
}

.indicator-icon-bg.pink-bg {
  background-color: var(--color-pink-bg);
}

.indicator-icon-bg.dark-translucent {
  background-color: rgba(255, 255, 255, 0.1);
}

.indicator-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-dark);
  line-height: 1.3;
}

.indicator-card.dark-theme .indicator-title {
  color: #ebf1ff;
}

.indicator-stats {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--color-dark);
}

.stat-value.red-text {
  color: var(--color-danger);
}

.stat-value.pink-text {
  color: var(--color-pink-accent);
}

.stat-item-dark .stat-value {
  color: #ebf1ff;
  text-align: center;
}

.stat-label {
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--color-text-subtle);
}

.stat-item-dark .stat-label {
  color: rgba(235, 241, 255, 0.6);
  text-align: center;
}

/* Participation Card */
.participation-card {
  background-color: var(--color-card-bg);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 20px;
}

.chart-wrapper {
  position: relative;
  width: 80px;
  height: 80px;
  flex-shrink: 0;
}

.chart-center-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-dark);
}

.participation-details {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.participation-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-dark);
}

.participation-rows {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--color-text-subtle);
}

/* Content Grid Section */
.content-grid {
  display: flex;
  flex-direction: column;
}

.articles-column {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--color-dark);
}

.see-all-link {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-primary);
  cursor: pointer;
}

.articles-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.article-card {
  background-color: var(--color-card-bg);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.article-card:hover {
  transform: translateY(-2px);
  box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.08);
}

.article-image-container {
  position: relative;
  width: 100%;
  height: 192px;
  background-color: var(--color-primary-bg);
  overflow: hidden;
}

.article-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.article-tag {
  position: absolute;
  top: 16px;
  right: 16px;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
  padding: 4px 12px;
  border-radius: 9999px;
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.05);
}

.article-tag.dark { color: var(--color-dark); }
.article-tag.red { color: var(--color-danger); }
.article-tag.green { color: var(--color-success); }

.article-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-grow: 1;
}

.article-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--color-dark);
  line-height: 1.4;
}

.article-snippet {
  font-size: 12px;
  color: var(--color-text-subtle);
  line-height: 1.5;
}

/* Sidebar Column */
.sidebar-column {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.sidebar-card {
  background-color: var(--color-card-bg);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.sidebar-card-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-dark);
}

.field-workers-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.worker-item {
  display: flex;
  align-items: center;
  gap: 16px;
}

.worker-avatar-wrapper {
  position: relative;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid var(--color-primary-light);
  overflow: hidden;
  flex-shrink: 0;
}

.worker-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.worker-info {
  flex: 1;
}

.worker-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-dark);
}

.worker-role {
  font-size: 12px;
  color: var(--color-text-subtle);
}

.online-status {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-success);
  box-shadow: 0px 0px 8px rgba(34, 197, 94, 0.6);
}

/* Survey Card */
.survey-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.survey-subtitle {
  font-size: 12px;
  font-weight: 700;
  color: var(--color-dark);
  margin-top: 4px;
}

.survey-items {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.survey-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.survey-label-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--color-dark);
}

.survey-pct {
  font-weight: 700;
}

.survey-bar-bg {
  width: 100%;
  height: 8px;
  border-radius: 9999px;
  background-color: var(--color-primary-bg);
  overflow: hidden;
}

.survey-bar-fill {
  height: 100%;
  border-radius: 9999px;

}

.survey-bar-fill.blue { background-color: var(--color-primary); }
.survey-bar-fill.light-blue { background-color: var(--color-primary-light); }

/* Footer */
.footer-wrapper {
  background-color: #f0f3ff;
  border-top: 1px solid var(--color-border);
  width: 100%;
  margin-top: 40px;
  display: flex;
  justify-content: center;
}

.footer-content {
  width: 100%;
  max-width: 1280px;
  padding: 40px 24px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 340px;
}

.footer-brand-title {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  font-weight: 700;
  color: var(--color-primary);
}

.footer-logo {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  object-fit: cover;
}

.footer-desc {
  font-size: 12px;
  color: var(--color-text-subtle);
  line-height: 1.5;
}

.footer-links-group {
  display: flex;
  gap: 32px;
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 140px;
}

.footer-col-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-dark);
}

.footer-link {
  font-size: 12px;
  color: var(--color-text-subtle);
  cursor: pointer;
  transition: color 0.2s ease;
}

.footer-link:hover {
  color: var(--color-primary);
}

.footer-bottom {
  border-top: 1px solid var(--color-border);
  padding-top: 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.copyright {
  font-size: 12px;
  color: var(--color-text-subtle);
}

.social-icons {
  display: flex;
  gap: 16px;
}

.social-icon-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: #e7eeff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  transition: background-color 0.2s ease;
}

.social-icon-btn:hover {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

/* Responsive Media Queries */
@media (max-width: 1024px) {
  .hero-grid, .content-grid {
    grid-template-columns: 1fr;
  }
  .patient-stat-card, .welcome-banner, .articles-column {
    grid-column: span 1;
  }
  .indicators-grid, .feature-cards-row {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  /* Welcome Banner Mobile */
  .welcome-banner {
    flex-direction: column-reverse;
    padding: 24px 16px;
    min-height: auto;
    text-align: center;
  }
  .welcome-illustration {
    position: relative;
    width: 100%;
    height: 192px;
    max-width: 100%;
    right: 0;
    top: 0;
    transform: none;
    margin-bottom: 24px;
    border-radius: 12px;
  }
  .welcome-content {
    align-items: center;
    text-align: center;
  }
  .welcome-actions {
    flex-direction: column;
    width: 100%;
    gap: 12px;
  }
  .btn-primary, .btn-outline {
    width: 100%;
    border-radius: 9999px;
  }

  /* Article Card Mobile (scoped to Beranda) */
  .beranda-page .articles-row {
    grid-template-columns: 1fr;
  }
  .beranda-page .article-card {
    flex-direction: row-reverse;
    align-items: flex-start;
  }
  .beranda-page .article-image-container {
    width: 120px;
    height: 112px;
    flex-shrink: 0;
  }
  .beranda-page .article-body {
    padding: 12px;
    flex-grow: 1;
  }
  .beranda-page .article-title {
    font-size: 14px;
  }
  .beranda-page .article-snippet {
    display: none; /* Hide snippet on mobile for compact view */
  }
  .beranda-page .article-tag {
    top: 8px;
    right: 8px;
    padding: 2px 8px;
    font-size: 10px;
  }

  /* Footer Mobile */
  .footer-top {
    flex-direction: column;
    gap: 32px;
  }
  .footer-links-group {
    gap: 24px;
    flex-wrap: wrap;
  }
}

@media (min-width: 768px) and (max-width: 1024px) {
  .header-navbar .hamburger-btn {
    display: none !important;
  }
  .header-nav {
    display: flex !important;
    gap: 10px;
  }
  .header-nav .nav-item {
    font-size: 12.5px;
  }
  .header-content {
    padding: 0 16px;
  }
}

@media (max-width:767px){

.beranda-container{
padding:16px;
gap:20px;
}

