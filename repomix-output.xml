}

.related-article-item:hover {
  background-color: var(--color-bg);
}

.related-article-img {
  width: 72px;
  height: 72px;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
}

.related-article-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.related-article-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
  justify-content: center;
}

.related-article-title {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-dark);
}

.related-article-readtime {
  font-size: 12px;
  color: var(--color-text-subtle);
}

.progress-cta-card {
  background-color: var(--color-primary);
  border-radius: 16px;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #ffffff;
}

.progress-cta-title {
  font-size: 18px;
  font-weight: 700;
  color: #ffffff;
}

.progress-cta-desc {
  font-size: 14px;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
