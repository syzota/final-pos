                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr><td colSpan="4" style={{ textAlign: 'center', padding: '16px', color: '#666' }}>Belum ada riwayat pendataan.</td></tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
