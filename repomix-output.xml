.badge-orange { background: var(--orange-bg); color: var(--orange-deep); }
.badge-rose { background: var(--rose-bg); color: var(--rose-deep); }
.badge-violet { background: var(--violet-bg); color: var(--violet-deep); }
.badge-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

.target-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 14px; font-weight: 700; font-size: 13px; cursor: pointer; border: 1.5px solid transparent; transition: .15s; }
.target-chip .dot { width: 10px; height: 10px; border-radius: 50%; }
.target-chip.cyan { background: var(--cyan-bg); color: var(--cyan-deep); }
.target-chip.cyan .dot { background: var(--cyan); }
.target-chip.orange { background: var(--orange-bg); color: var(--orange-deep); }
.target-chip.orange .dot { background: var(--orange); }
.target-chip.magenta { background: var(--magenta-bg); color: var(--magenta-deep); }
.target-chip.magenta .dot { background: var(--magenta); }
.target-chip.green { background: var(--green-bg); color: var(--green-deep); }
.target-chip.green .dot { background: var(--green); }
.target-chip.violet { background: var(--violet-bg); color: var(--violet-deep); }
.target-chip.violet .dot { background: var(--violet); }
.target-chip.active { border-color: currentColor; }

.form-chip { padding: 8px 14px; border-radius: 100px; font-size: 12px; font-weight: 700; background: var(--bg); color: var(--ink-soft); cursor: pointer; border: 1.5px solid transparent; white-space: nowrap; }
.form-chip.active { background: var(--violet-bg); color: var(--violet-deep); border-color: var(--violet-deep); }

.table { width: 100%; border-collapse: collapse; font-size: 13px; }
.table th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-faint); font-weight: 700; padding: 10px 12px; border-bottom: 1.5px solid var(--line); }
.table td { padding: 13px 12px; border-bottom: 1px solid var(--line); font-weight: 500; }
.table tr:last-child td { border-bottom: none; }
.row-highlight { background: var(--violet-bg); }
.table input { padding: 7px 9px; border-radius: 8px; border: 1.5px solid var(--line); font-family: inherit; font-size: 12.5px; width: 100%; }

.btn { padding: 9px 16px; border-radius: 11px; font-weight: 700; font-size: 12.5px; cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 6px; }
.btn-violet { background: var(--violet-deep); color: #fff; }
.btn-outline { background: #fff; border: 1.5px solid var(--line); color: var(--ink-soft); }
.btn-outline:hover { border-color: var(--violet-deep); color: var(--violet-deep); }
.btn-soft { background: var(--violet-bg); color: var(--violet-deep); }
.btn-sm { padding: 7px 12px; font-size: 11.5px; border-radius: 9px; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-field label { display: block; font-size: 12px; font-weight: 700; color: var(--ink-soft); margin-bottom: 6px; }
.form-field input, .form-field select, .form-field textarea {
  width: 100%; padding: 11px 13px; border-radius: 11px; border: 1.5px solid var(--line);
  font-family: inherit; font-size: 13.5px; background: #F5F8FF; outline: none;
}
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--violet-deep); background: #fff; }
.form-field.full { grid-column: 1 / -1; }
.field-hint { display: inline-flex; align-items: center; gap: 4px; color: var(--ink-faint); }

.result-box {
  border-radius: 16px; padding: 16px 18px; display: flex; align-items: center; gap: 14px;
  background: var(--green-bg); border: 1.5px dashed var(--green-deep);
}
.result-box .r-num { font-size: 22px; font-weight: 800; color: var(--green-deep); }
.result-box .r-label { font-size: 11.5px; font-weight: 700; color: var(--green-deep); opacity: .8; }

.export-row { display: flex; gap: 8px; }
.export-btn {
  display: flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 10px;
  font-size: 11.5px; font-weight: 800; border: 1.5px solid var(--line); background: #fff; cursor: pointer; color: var(--ink-soft);
}
.export-btn:hover { border-color: var(--violet-deep); color: var(--violet-deep); }

.tabs { display: flex; gap: 6px; background: var(--bg); padding: 5px; border-radius: 13px; width: fit-content; margin-bottom: 18px; flex-wrap: wrap; }
.tab-btn { padding: 9px 16px; border-radius: 9px; font-size: 12.5px; font-weight: 700; color: var(--ink-soft); cursor: pointer; border: none; background: transparent; display: flex; align-items: center; gap: 6px; }
.tab-btn.active { background: #fff; color: var(--violet-deep); box-shadow: var(--shadow); }

.article-card { border-radius: var(--radius-md); overflow: hidden; border: 1.5px solid var(--line); display: flex; flex-direction: column; background: var(--surface); transition: .15s; }
.article-thumb { height: 110px; width: 100%; display: flex; align-items: center; justify-content: center; }
.article-body { padding: 14px; }
.article-cat { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
.article-title { font-size: 14px; font-weight: 700; margin: 6px 0 4px; line-height: 1.3; color: var(--ink); }
.article-meta { font-size: 11px; color: var(--ink-soft); font-weight: 600; }
.article-card.is-draft { border-style: dashed; }
.article-status-row { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 6px; }
.article-actions { display: flex; gap: 6px; padding: 0 14px 14px; margin-top: auto; }
.article-actions button { flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px; padding: 7px 6px; border-radius: 9px; border: 1.5px solid var(--line); background: var(--surface); font-weight: 700; font-size: 11px; color: var(--ink-soft); cursor: pointer; transition: .15s; }
.article-actions button:hover { background: var(--surface-container-low); color: var(--ink); }
.article-actions button.act-danger:hover { background: var(--rose-bg); color: var(--rose-deep); border-color: var(--rose-bg); }
.article-actions button.act-primary { background: var(--violet-bg); color: var(--violet-deep); border-color: var(--violet-bg); }
.article-actions button.act-primary:hover { filter: brightness(0.97); }
.article-card.editing { outline: 2px solid var(--violet-deep); outline-offset: -2px; }
.article-form-hint { display: none; align-items: center; gap: 6px; background: var(--violet-bg); color: var(--violet-deep); font-weight: 700; font-size: 11.5px; padding: 8px 10px; border-radius: 10px; margin-bottom: 12px; }
.article-form-hint.active { display: flex; }
.article-form-hint button { margin-left: auto; background: none; border: none; color: var(--violet-deep); font-weight: 800; cursor: pointer; font-size: 11px; text-decoration: underline; }

.progress-track { height: 8px; border-radius: 100px; background: var(--line); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 100px; background: linear-gradient(90deg, var(--violet-deep), var(--magenta-deep)); }

.upload-box {
  border: 2px dashed var(--line); border-radius: 16px; padding: 22px; text-align: center; color: var(--ink-soft);
  font-size: 12.5px; font-weight: 600; background: #F5F8FF; display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.upload-box b { color: var(--violet-deep); }

.sidebar-backdrop { display: none; }

.callout {
  border-radius: 14px; padding: 13px 16px; font-size: 12.5px; font-weight: 600; color: var(--orange-deep);
  background: var(--orange-bg); border: 1.5px solid #F5D9B8; display: flex; gap: 10px; align-items: flex-start;
}
.field-note { display: flex; gap: 8px; align-items: flex-start; font-size: 11.5px; color: var(--ink-faint); font-weight: 600; margin-top: 10px; }

.bidang-icon-tile { width: 38px; height: 38px; border-radius: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.table-responsive {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: var(--radius-md);
  margin-bottom: 12px;
}

@media(max-width:900px) {
