<file path="resources/js/styles/profil.css">
/* Profil Posyandu Styles */

.profil-wrapper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg);
}

.profil-container {
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 32px 24px 64px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.profil-section {
  width: 100%;
}

.grid-2-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

@media (max-width: 992px) {
  .grid-2-col {
    grid-template-columns: 1fr;
  }
}

/* Common Section Badges */
.section-badge {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: var(--color-primary);
  background-color: var(--color-primary-bg);
  padding: 6px 14px;
  border-radius: 20px;
  margin-bottom: 12px;
}

.section-badge.pink {
  color: var(--color-pink-accent);
  background-color: var(--color-pink-bg);
}

/* 1. Hero Banner */
.profil-hero-card {
  position: relative;
  background: linear-gradient(135deg, rgba(153, 194, 241, 0.25) 0%, rgba(222, 232, 255, 0.4) 100%);
  border: 1px solid rgba(153, 194, 241, 0.4);
  border-radius: 16px;
  padding: 48px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(55, 97, 139, 0.06);
}

.hero-bg-wrapper {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 35%;
  opacity: 0.25;
  pointer-events: none;
  overflow: hidden;
}

.hero-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 860px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.hero-title-main {
  font-size: 32px;
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: -0.5px;
}

.hero-badge {
  font-size: 28px;
  font-weight: 700;
  color: #ffffff !important;
  background-color: var(--color-primary, #37618b);
  padding: 4px 16px;
  border-radius: 8px;
}

.hero-quote {
  font-size: 17px;
  line-height: 1.6;
  font-weight: 600;
  font-style: italic;
  color: var(--color-primary);
}

.hero-desc {
  font-size: 15px;
  line-height: 1.6;
  color: var(--color-text-subtle);
}

/* 2. Chairman Card */
.chairman-card {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
}

.chairman-avatar-wrapper {
  margin-bottom: 16px;
}

.avatar-ring {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  border: 4px solid var(--color-primary-light);
  padding: 4px;
  box-shadow: 0 4px 12px rgba(55, 97, 139, 0.15);
  background-color: #ffffff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chairman-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

.chairman-name {
  font-size: 24px;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 4px;
}

.chairman-role {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 4px;
}

.chairman-subtext {
  font-size: 13px;
  color: var(--color-text-subtle);
  margin-bottom: 20px;
}

.chairman-actions {
  display: flex;
  gap: 16px;
}

.action-circle-btn {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background-color: var(--color-primary-light);
  color: #235078;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.action-circle-btn:hover {
  background-color: var(--color-primary);
  color: #ffffff;
  transform: translateY(-2px);
}

/* 3. Basic Contact Card */
.basic-contact-card {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 24px;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px 24px;
}

@media (max-width: 640px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }
}

.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.contact-icon-box {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background-color: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.contact-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
  color: var(--color-text-subtle);
  text-transform: uppercase;
}

.contact-value {
  font-size: 14px;
  font-weight: 500;
  color: var(--color-dark);
  line-height: 1.4;
  word-break: break-word;
  overflow-wrap: anywhere;
}

/* 4 & 5. Tasks Cards */
.tasks-card {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  border-left: 5px solid var(--color-primary);
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.tasks-card.strategic-functions {
  border-left-color: var(--color-pink-accent);
}

.card-header-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header-icon-badge {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-icon-badge.blue {
  background-color: var(--color-primary-bg);
  color: var(--color-primary);
}

.header-icon-badge.pink {
  background-color: var(--color-pink-bg);
  color: var(--color-pink-accent);
}

.section-title {
  font-size: 22px;
  font-weight: 700;
}

.section-title.blue {
  color: var(--color-primary);
}

.section-title.pink {
  color: var(--color-pink-accent);
}

.task-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.task-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 15px;
  line-height: 1.5;
  color: var(--color-text-subtle);
}

.check-icon {
  flex-shrink: 0;
  margin-top: 2px;
}

.check-icon.blue {
  color: var(--color-primary);
}

.check-icon.pink {
  color: var(--color-pink-accent);
}

/* 6. Struktur Kepengurusan Section */
.struktur-card {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.struktur-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.btn-outline-sm {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--color-primary);
  transition: background-color 0.15s ease;
}

.btn-outline-sm:hover {
  background-color: var(--color-primary-bg);
}

.struktur-members-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

@media (max-width: 768px) {
  .struktur-members-row {
    grid-template-columns: 1fr;
  }
}

.struktur-member {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 4px;
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: 12px;
}

.struktur-avatar-wrapper {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 12px;
  border: 3px solid var(--color-primary-bg);
}

.struktur-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.struktur-member-name {
