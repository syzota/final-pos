<file path="resources/js/styles/artikel.css">
/* ===================================
   ARTIKEL KESEHATAN PAGE STYLES
   =================================== */

.artikel-page {
  min-height: 100vh;
  background-color: #f9f9ff;
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
}

/* ===================================
   ARTIKEL MAIN CONTENT
   =================================== */
.artikel-main {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px 24px 64px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* ===================================
   HERO BANNER
   =================================== */
.artikel-hero {
  border-radius: 8px;
  background-color: rgba(153, 194, 241, 0.2);
  overflow: hidden;
  position: relative;
  padding: 48px;
  min-height: 240px;
}

.artikel-hero-bg {
  position: absolute;
  top: 50%;
  right: 40px;
  transform: translateY(-50%);
  width: 40%;
  height: calc(100% - 64px);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.artikel-hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.artikel-hero-content {
  position: relative;
  z-index: 1;
  max-width: 762px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.artikel-hero-title {
  font-size: 32px;
  font-weight: 700;
  line-height: 40px;
  letter-spacing: -0.6px;
  color: #001d35;
}

.artikel-hero-subtitle {
  font-size: 18px;
  font-weight: 400;
  line-height: 28px;
  color: #1b4972;
  max-width: 576px;
}

.artikel-hero-actions {
  display: flex;
  flex-direction: row;
  gap: 16px;
  align-items: center;
  padding-top: 16px;
  flex-wrap: wrap;
}

.btn-cari {
  border-radius: 8px;
  background-color: #37618b;
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
  padding: 12px 24px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  cursor: pointer;
  border: none;
  transition: background-color 0.2s ease, transform 0.15s ease;
  box-shadow: 0px 10px 15px -3px rgba(0,0,0,0.1), 0px 4px 6px -4px rgba(0,0,0,0.1);
}

.btn-cari:hover {
  background-color: #2a4f73;
  transform: translateY(-1px);
}

.btn-kategori {
  border-radius: 8px;
  background-color: #fff;
  border: 1px solid rgba(55, 97, 139, 0.2);
  padding: 13px 24px;
  color: #37618b;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.15s ease;
}

.btn-kategori:hover {
  background-color: #f0f5fb;
  transform: translateY(-1px);
}

/* ===================================
   FILTER BAR
   =================================== */
.artikel-filter-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0 0;
  gap: 16px;
}

.topik-chips {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  flex: 1;
}

.chip {
  border-radius: 9999px;
  padding: 8px 16px;
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.15s ease;
  white-space: nowrap;
  border: none;
}

.chip:hover {
