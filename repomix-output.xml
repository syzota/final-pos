/* =========================================================
   KALKULATOR HERO V2
   Background menggunakan calt.jpg
   ========================================================= */

.kalkulator-cover-hero {
  position: relative;
  width: 100%;
  min-height: 500px;
  padding: 62px 56px 58px;
  border-radius: 30px;
  overflow: hidden;
  isolation: isolate;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background: #315f8a;
  box-shadow: 0 22px 55px rgba(34, 67, 101, 0.16);
}

.kalkulator-cover-hero__media {
  position: absolute;
  inset: 0;
  z-index: -3;
}

.kalkulator-cover-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  transform: scale(1.02);
}

.kalkulator-cover-hero__overlay {
  position: absolute;
  inset: 0;
  background: rgba(33, 75, 116, 0.70);
  z-index: 1;
}

.kalkulator-cover-hero__gradient {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(
      90deg,
      rgba(18, 49, 80, 0.86) 0%,
      rgba(36, 80, 122, 0.68) 48%,
      rgba(48, 93, 137, 0.34) 100%
    ),
    linear-gradient(
      180deg,
      rgba(7, 29, 50, 0.04) 0%,
      rgba(7, 29, 50, 0.08) 58%,
      rgba(7, 29, 50, 0.28) 100%
    );
}

.kalkulator-cover-hero__content {
  position: relative;
  z-index: 4;
  width: 100%;
  max-width: 720px;
}

.kalkulator-cover-hero__badge {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
