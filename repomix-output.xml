            ['username'  => 'petugas.puskesmas'],
            [
                'name'        => 'Bidan Fitri',
                'role'        => 'puskesmas',
                'posyandu_id' => null,
                'password'    => 'password123',
            ]
        );

        // 4. Akun Warga Contoh (Terdaftar di Posyandu Melati)
        User::updateOrCreate(
            ['username'  => 'warga.budi'],
            [
                'name'        => 'Budi Santoso',
