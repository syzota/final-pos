  .detail-artikel-title {
    font-size: 22px;
    line-height: 1.3;
  }

  .detail-artikel-meta {
    gap: 6px;
    font-size: 12px;
  }

  .detail-artikel-intro {
    font-size: 14.5px;
    line-height: 1.6;
  }

  .detail-artikel-heading {
    font-size: 19px;
  }

  .detail-artikel-paragraph {
    font-size: 14px;
    line-height: 1.6;
  }

  .detail-artikel-quote {
    padding: 14px 16px;
    font-size: 14px;
    line-height: 1.5;
  }

  .detail-artikel-list {
    padding-left: 16px;
    font-size: 13.5px;
  }

  .detail-artikel-closing-img {
    height: 180px;
