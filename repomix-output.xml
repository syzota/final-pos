/* =========================================================
   MEDICAL HERO - BLUE RESPONSIVE VERSION
   ========================================================= */

.medical-hero {
  position: relative;
  width: 100%;
  min-height: 620px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 70px 48px 120px;
  margin-bottom: 58px;
  border-radius: 32px;
  background-color: #37618b;
  overflow: visible;
  isolation: isolate;
  box-shadow: 0 24px 60px rgba(37, 74, 111, 0.16);
}

.medical-hero__background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: inherit;
  z-index: -3;
}

.medical-hero__background-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transform: scale(1.02);
}

.medical-hero__overlay {
  position: absolute;
  inset: 0;
  background: rgba(32, 76, 118, 0.78);
  z-index: 1;
}

.medical-hero__gradient {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(90deg, rgba(20, 55, 90, 0.55) 0%, rgba(55, 97, 139, 0.12) 50%, rgba(28, 69, 108, 0.42) 100%),
    linear-gradient(180deg, rgba(5, 24, 42, 0.08) 0%, rgba(5, 24, 42, 0.02) 55%, rgba(5, 24, 42, 0.22) 100%);
}

.medical-hero__content {
  position: relative;
  z-index: 5;
