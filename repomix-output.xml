    #edf1f5;

  display: flex;

  flex-direction: column;

  gap: 3px;
}


.kontak-info-card-value strong {
  color: #37618b;

  font-size: 20px;

  font-weight: 800;
}


.kontak-info-card--emergency
.kontak-info-card-value strong {
  color: #b42318;
}


.kontak-info-card-value span {
  color: #8998a8;

  font-size: 10.5px;
}


/* =========================================================
   PREPARATION GUIDE
   ========================================================= */

.kontak-guide-section {
  padding: 34px;

  border-radius: 26px;

  background: #eff6fd;

  border:
    1px solid
    #dce9f6;
}


.kontak-guide-header {
  display: flex;

  align-items: center;

  gap: 15px;

  margin-bottom: 28px;
}


.kontak-guide-header-icon {
  width: 50px;
  height: 50px;

  flex-shrink: 0;

  border-radius: 15px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #37618b;

  color: white;

  font-size: 20px;
}


.kontak-guide-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 16px;
}


.kontak-guide-item {
  display: flex;

  gap: 16px;

  padding: 20px;

  border-radius: 18px;

  background:
    rgba(255, 255, 255, 0.82);

  border:
    1px solid
    rgba(214, 227, 240, 0.9);
}


.kontak-guide-number {
  color: #8eabc8;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: 0.04em;
}


.kontak-guide-item h3 {
  margin:
    0
    0
    7px;

  color: #263f59;

  font-size: 14px;

  font-weight: 800;
}


.kontak-guide-item p {
  margin: 0;

  color: #708195;

  font-size: 11.5px;

  line-height: 1.65;
}


/* =========================================================
   LOCATION COUNT
   ========================================================= */

.kontak-location-heading {
  align-items: center;
}


.kontak-location-count {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 12px 18px;

  border-radius: 16px;

  background: #e8f2fc;

  color: #37618b;
}


.kontak-location-count strong {
  font-size: 28px;

  line-height: 1;

  font-weight: 800;
}


.kontak-location-count span {
  color: #637d96;

  font-size: 9.5px;

  line-height: 1.25;

  font-weight: 700;

  text-transform: uppercase;
}


/* =========================================================
   LOCATION CARDS
   ========================================================= */

.kontak-location-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 16px;
}


.kontak-location-card {
  position: relative;

  min-width: 0;

  display: grid;

  grid-template-columns:
    auto
    1fr;

  gap:
    15px
    14px;

  padding: 20px;

  border:
    1px solid
    #e0e8f0;

  border-radius: 20px;

  background: #ffffff;

  box-shadow:
    0 7px 24px
    rgba(33, 62, 91, 0.05);
}


.kontak-location-number {
  position: absolute;

  top: 14px;
  right: 15px;

  color: #d8e3ed;

  font-size: 20px;

  font-weight: 800;
}


.kontak-location-icon {
  width: 44px;
  height: 44px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 13px;

  background: #e7f1fc;

  color: #37618b;

  font-size: 18px;
}


.kontak-location-content {
  min-width: 0;

  padding-right: 20px;
}


.kontak-location-content h3 {
  margin:
    1px
    0
    10px;

  color: #203b56;

  font-size: 14px;

  line-height: 1.4;

  font-weight: 800;
}


.kontak-location-address {
  display: flex;

  align-items: flex-start;

  gap: 7px;

  color: #667b8f;

  font-size: 11.5px;

  line-height: 1.45;
}


.kontak-location-address i {
  margin-top: 1px;

  color: #8aa4bd;
}


.kontak-location-coords {
  margin-top: 7px;

  color: #98a6b4;

  font-size: 9.5px;

  letter-spacing: 0.02em;
}


.kontak-location-map {
  grid-column:
    1 / -1;

  min-height: 40px;

  margin-top: 4px;

  padding:
    0
    14px;

  border-radius: 12px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  background: #f3f7fb;

  color: #37618b;

  text-decoration: none;

  font-size: 11.5px;

  font-weight: 800;

  transition:
    background-color 0.2s ease,
    color 0.2s ease;
}


.kontak-location-map:hover {
  background: #37618b;

  color: #ffffff;
}


/* =========================================================
   AREA / MAP SECTION
   ========================================================= */

.kontak-area-section {
  display: grid;

  grid-template-columns:
    1.1fr
    0.9fr;

  gap: 34px;

  align-items: stretch;

  padding: 22px;

  border-radius: 26px;

  border:
    1px solid
    #e0e9f1;

  background: #ffffff;
}


.kontak-area-image {
  position: relative;

  min-height: 350px;

  overflow: hidden;

  border-radius: 20px;

  background: #e6eef5;
}


.kontak-area-image > img {
  width: 100%;
  height: 100%;

  position: absolute;

  inset: 0;

  object-fit: cover;
}


.kontak-area-overlay {
  position: absolute;

  left: 18px;
  bottom: 18px;

  display: flex;

  align-items: center;

  gap: 12px;

  padding:
    11px
    15px;

  border-radius: 15px;

  background:
    rgba(255, 255, 255, 0.92);

  backdrop-filter: blur(8px);

  box-shadow:
    0 8px 20px
    rgba(26, 54, 81, 0.12);
}


.kontak-area-pin {
  width: 37px;
  height: 37px;

  border-radius: 11px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #37618b;

  color: white;
}


.kontak-area-overlay span {
  display: block;

  margin-bottom: 2px;

  color: #8999a8;

  font-size: 8.5px;

  font-weight: 800;

  letter-spacing: 0.08em;
}


.kontak-area-overlay strong {
  color: #263f57;

  font-size: 12px;
}


.kontak-area-content {
  display: flex;

  flex-direction: column;

  justify-content: center;

  padding:
    25px
    18px;
}


.kontak-area-content h2 {
  margin-bottom: 17px;

  line-height: 1.25;
}


.kontak-area-content > p {
  margin: 0;

  color: #708195;

  font-size: 13px;

  line-height: 1.8;
}


.kontak-area-note {
  display: flex;

  align-items: flex-start;

  gap: 11px;

  margin-top: 24px;

  padding: 14px;

  border-radius: 14px;

  background: #eff6fc;

  color: #4d6780;
}


.kontak-area-note i {
  margin-top: 2px;

  color: #37618b;
}


.kontak-area-note p {
  margin: 0;

  font-size: 11.5px;

  line-height: 1.65;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1024px) {

  .kontak-info-hero {
    grid-template-columns:
      1fr;

    min-height: auto;

    padding: 40px;
  }


  .kontak-info-hero__notice {
    max-width: 650px;
  }


  .kontak-info-cards {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  .kontak-info-card:last-child {
    grid-column:
      1 / -1;
  }


  .kontak-guide-grid {
    grid-template-columns: 1fr;
  }


  .kontak-location-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  .kontak-area-section {
    grid-template-columns: 1fr;
  }


  .kontak-area-image {
    min-height: 300px;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767px) {

  .kontak-info-main {
    padding:
      20px
      16px
      60px;

    gap: 42px;
  }


  /* HERO */

  .kontak-info-hero {
    padding:
      30px
      20px;

    gap: 28px;

    border-radius: 22px;
  }


  .kontak-info-eyebrow {
    font-size: 10px;

    margin-bottom: 16px;
  }


  .kontak-info-hero h1 {
    font-size:
      clamp(
        2rem,
        9vw,
        2.8rem
      );

    line-height: 1.04;
  }


  .kontak-info-hero__content > p {
    margin-top: 17px;

    font-size: 13px;

    line-height: 1.7;
  }


  .kontak-info-hero__notice {
    padding: 16px;

    border-radius: 16px;
  }


  .kontak-info-notice-icon {
    width: 40px;
    height: 40px;

    border-radius: 12px;
  }


  /* TITLE */

  .kontak-info-heading {
    align-items: flex-start;

    flex-direction: column;
  }


  /* INFO CARDS */

  .kontak-info-cards {
    grid-template-columns: 1fr;
  }


  .kontak-info-card,
  .kontak-info-card:last-child {
    grid-column: auto;

    min-height: auto;

    padding: 20px;

    border-radius: 18px;
  }


  .kontak-info-card-icon {
    margin-bottom: 20px;
  }


  .kontak-info-card-content > p {
    min-height: auto;
  }


  /* GUIDE */

  .kontak-guide-section {
    padding: 22px 18px;

    border-radius: 20px;
  }


  .kontak-guide-header {
    align-items: flex-start;
  }


  .kontak-guide-grid {
    gap: 10px;
  }


  .kontak-guide-item {
    padding: 16px;

    border-radius: 15px;
  }


  /* LOCATIONS */

  .kontak-location-heading {
    flex-direction: row;

    align-items: center;
  }


  .kontak-location-count {
    flex-shrink: 0;

    padding: 10px 13px;
  }


  .kontak-location-grid {
    grid-template-columns: 1fr;
  }


  .kontak-location-card {
    border-radius: 17px;
  }


  /* MAP */

  .kontak-area-section {
    gap: 12px;

    padding: 12px;

    border-radius: 20px;
  }


  .kontak-area-image {
    min-height: 240px;

    border-radius: 15px;
  }


  .kontak-area-content {
    padding:
      18px
      8px
      10px;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 420px) {

  .kontak-info-main {
    padding-left: 12px;

    padding-right: 12px;
  }


  .kontak-info-hero {
    padding:
      26px
      17px;

    border-radius: 18px;
  }


  .kontak-info-hero h1 {
    font-size: 2rem;
  }


  .kontak-location-heading {
    align-items: flex-start;

    flex-direction: column;
  }


  .kontak-location-count {
    width: fit-content;
  }


  .kontak-area-image {
    min-height: 210px;
  }

}
</file>

<file path="resources/js/styles/mobile-nav.css">
